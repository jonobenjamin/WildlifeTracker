# ── Firebase Admin (server-side, used by API routes) ──────────────────────
# Paste the full service-account JSON as a single-line string.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_PROJECT_ID=wildlifetracker-4d28b
FIREBASE_DATABASE_ID=wildlifetracker-db

# ── Shared API key required by /api/observations, /api/trees, /api/tracking,
# /api/map, /api/water-monitoring (same key the Flutter PWA already sends). ─
API_KEY=
NEXT_PUBLIC_API_KEY=

# ── Admin API key — server-side only, never exposed to the browser.
# Protects /api/admin/* (user management). Proxied via Next.js server actions. ──
ADMIN_API_KEY=

# ── CORS (comma separated extra origins, .vercel.app and github.io already allowed) ──
ALLOWED_ORIGINS=

# ── Resend (PIN login + observation/fire alert emails) ─────────────────────
# Reuse the existing Okavango Water Resend API key. From-address MUST be on the
# verified okavangowater.com domain (Resend will reject other senders).
RESEND_API_KEY=
RESEND_FROM_EMAIL=alerts@okavangowater.com
EMAIL_FROM_NAME=KPR Wildlife Tracker
# Optional legacy fallback if no Admin → Configure Notifications rules match:
# NOTIFICATION_EMAILS=person1@example.com,person2@example.com

# ── NASA FIRMS fire data (optional) ────────────────────────────────────────
FIRMS_MAP_KEY=

# ── Okavango Water partner API (historical water-extent raster overlays) ──
# Server-side only — proxied via /api/okavango-water/* so the key never
# reaches the browser. Get these from okavangowater.com.
OKAVANGO_API_BASE=https://okavangowater.com
OKAVANGO_PARTNER_SLUG=kpr-okavangowater
OKAVANGO_API_KEY=

# ── Vercel Cron auth for /api/cron/fire-check (Vercel sends this as a Bearer token
# automatically once you set CRON_SECRET in the project's env vars). ───────
CRON_SECRET=

# ── Firebase Web SDK (public, safe to expose — used by the browser) ───────
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyCHpJdRUch5Na_6HgM6dxgWxfoKeciPo_s
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=wildlifetracker-4d28b.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=wildlifetracker-4d28b
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=wildlifetracker-4d28b.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=209541121506
NEXT_PUBLIC_FIREBASE_APP_ID=1:209541121506:web:7fe9890f91be06dc4ba5bb
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-4XLR7JTEEH
NEXT_PUBLIC_FIREBASE_DATABASE_ID=wildlifetracker-db

# Same-origin API by default in this app; only needed if calling a different host.
NEXT_PUBLIC_API_BASE=
